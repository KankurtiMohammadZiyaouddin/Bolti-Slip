# =============================================================================
# Bolti Slip — Environment Configuration Template
# =============================================================================

# Gnani AI API credentials (Required for voice transcription & speech confirmation)
# Obtain your key from https://vachana.ai
GNANI_API_KEY_ID=your_gnani_api_key_here

# -----------------------------------------------------------------------------
# Database Configuration (Optional in dev, Required for Render + Neon)
# -----------------------------------------------------------------------------
# Neon PostgreSQL connection URL.
# If omitted or empty, Bolti Slip defaults to local SQLite (bolti_slip.db).
# Example format:
# DATABASE_URL=postgresql://user:password@ep-cool-fog-12345.us-east-2.aws.neon.tech/neondb?sslmode=require
# DATABASE_URL=

# -----------------------------------------------------------------------------
# First-Run Seed Configuration (Optional)
# -----------------------------------------------------------------------------
# If you want Bolti Slip to automatically seed a default shop account ('sharma')
# on first startup when the database has zero shops, set a secure password below
# (minimum 6 characters, maximum 128 characters).
#
# If omitted or left blank, NO default account is created.
# Instead, the first shopkeeper can set up their account via:
#   1. Web UI: Navigate to /register on first launch
#   2. CLI: Run python scripts/setup_first_shop.py
#
# IMPORTANT:
# - Never commit real passwords, tokens, or API keys to version control.
# - This variable is only evaluated when the `shops` table is completely empty.
BOLTI_SEED_PASSWORD=your_secure_seed_password_here

# -----------------------------------------------------------------------------
# Database Backup Configuration (Optional)
# -----------------------------------------------------------------------------
# Dedicated directory for automated SQLite database backups.
# Defaults to `backups` in the project root if omitted.
BOLTI_BACKUP_DIR=backups

# Number of days to retain backup files before automatic cleanup (default: 30).
BOLTI_BACKUP_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Production CORS Configuration (Optional in dev, Required in production)
# -----------------------------------------------------------------------------
# Environment mode: "development" (default) or "production"
# - In development mode, localhost origins (5173, 3000) are permitted by default.
# - In production mode, ONLY origins explicitly configured below are permitted.
BOLTI_ENV=development

# Comma-separated list of allowed frontend origins for cross-origin API requests.
# Wildcards (*) are strictly forbidden in production mode.
# Example: https://bolti-slip.vercel.app
BOLTI_CORS_ORIGINS=https://bolti-slip.vercel.app
